{
    "name": "gdnacho/poob",
    "description": "Input/Output DTO generator, validator, and OpenAPI docs generator.",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gdnacho\\Poob\\": "src/"
        }
    },
    "authors": [
        {
            "name": "gdnacho",
            "email": "tatecaroro7@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/console": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/config": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "scripts": {
        "fix": "php-cs-fixer fix"
    }
}
